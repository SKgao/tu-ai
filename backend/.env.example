PORT=3000
DATABASE_URL=postgresql://tutu_admin:tutu_admin@localhost:5432/tutu_admin?schema=public
# 必填。未配置服务会拒绝启动；请替换为至少 32 位随机字符串，不要沿用下面的示例值。
# 可用 `openssl rand -hex 32` 生成。
JWT_SECRET=tutu-admin-local-secret
JWT_EXPIRES_IN=7d
# 超级管理员角色 ID，逗号分隔（默认 1）。决定哪些角色可以访问用户/角色/菜单管理接口。
SUPER_ADMIN_ROLE_IDS=1
DEFAULT_ADMIN_ID=1
DEFAULT_ADMIN_ACCOUNT=admin
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_ADMIN_AVATAR=https://placehold.co/160x160/png

# ── 外部依赖（素材模块）──────────────────────────────────────────────
# 这三个能力依赖仓库外的服务，调用协议不在本仓库内。
# 目前的实现只做「配置探测」：未配置（或已配置但协议未实现）时返回明确错误，
# 不会静默假装成功。确认协议后再补具体调用。
# 批量同步素材到外部系统 line（test/send2line/source）
SEND2LINE_BASE_URL=
# 批量下载素材音频（source/audio/down/batch）
SOURCE_AUDIO_DOWNLOAD_BASE_URL=
# 题目-素材导入（subject/source/import）
SUBJECT_SOURCE_IMPORT_BASE_URL=
