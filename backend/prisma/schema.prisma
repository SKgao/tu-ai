generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  account      String   @unique
  username     String
  passwordHash String
  avatar       String?
  phone        String?
  email        String?
  name         String?
  sex          Int?
  status       Int      @default(1)
  /// 每次退出登录自增，使该用户已签发的所有 token 立即失效
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  userMenus    UserMenu[]
}

model MemberLevel {
  userLevel   Int      @id
  levelName   String
  explainInfo String?  @default("")
  exprieDays  Int?     @default(0)
  orgMoney    Int?     @default(0)
  needMoney   Int?     @default(0)
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     Member[]
  activities  Activity[]
  orders      Order[]
}

model Member {
  id                   Int              @id @default(autoincrement())
  tutuNumber           Int              @unique
  realName             String
  icon                 String?
  inviteCount          Int              @default(0)
  channel              Int              @default(1)
  hasBuyTextbook       Int              @default(0)
  payTime              DateTime?
  exprieTime           DateTime?
  userMoney            Int              @default(0)
  mobile               String?
  email                String?
  birthday             DateTime?
  sex                  Int?
  hasSetPassword       Int              @default(1)
  bookVersionName      String?
  textbookNamePractice String?
  status               Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  userLevel            Int              @default(0)
  level                MemberLevel      @relation(fields: [userLevel], references: [userLevel])
  feedbacks            MemberFeedback[]
  orders               Order[]
  invitesSent          MemberInvite[]   @relation("MemberInviteSender")
  invitesReceived      MemberInvite[]   @relation("MemberInviteReceiver")
  learningRecords      LearningRecord[]

  @@index([userLevel])
  @@index([status])
  @@index([mobile])
  @@index([createdAt])
  @@index([payTime])
  @@index([exprieTime])
}

model MemberFeedback {
  id        Int      @id @default(autoincrement())
  memberId   Int
  content   String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
}

model Activity {
  id               Int          @id @default(autoincrement())
  title            String
  content          String?
  icon             String?
  activeMoney      Int?
  status           Int          @default(1)
  activityType     Int          @default(1)
  itemId           Int?
  activeExpireDays Int?
  beginAt          DateTime?
  endAt            DateTime?
  url              String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  level            MemberLevel? @relation(fields: [itemId], references: [userLevel])
  orders           Order[]

  @@index([status])
  @@index([activityType])
  @@index([itemId])
  @@index([createdAt])
}

model Grade {
  id        Int      @id @default(autoincrement())
  gradeName String   @unique
  status    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model BookVersion {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model CourseBag {
  id        Int              @id @default(autoincrement())
  title     String           @unique
  icon      String?
  sort      Int              @default(0)
  status    Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  courses   CourseBagCourse[]

  @@index([status])
  @@index([sort])
  @@index([createdAt])
}

model CourseBagCourse {
  id        Int       @id @default(autoincrement())
  bagId     Int
  name      String
  icon      String?
  sort      Int       @default(0)
  status    Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bag       CourseBag @relation(fields: [bagId], references: [id], onDelete: Cascade)
  activities CourseBagActivity[]

  @@index([bagId])
  @@index([status])
  @@index([sort])
  @@index([createdAt])
}

model CourseBagActivity {
  id         Int            @id
  textbookId Int
  teacher    String
  status     Int            @default(1)
  type       Int            @default(1)
  saleBeginAt DateTime
  saleEndAt  DateTime
  beginAt    DateTime?
  endAt      DateTime?
  orgAmt     Int            @default(0)
  amt        Int            @default(0)
  num        Int            @default(0)
  chatNo     String?
  iconDetail String?
  iconTicket String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  course     CourseBagCourse @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@index([textbookId])
  @@index([status])
  @@index([type])
  @@index([saleBeginAt])
  @@index([createdAt])
}

model SpecialCourse {
  textbookId  Int      @id
  textbookName String
  teacher     String
  status      Int      @default(1)
  type        Int      @default(1)
  saleBeginAt DateTime
  saleEndAt   DateTime
  beginAt     DateTime?
  endAt       DateTime?
  orgAmt      Int      @default(0)
  amt         Int      @default(0)
  num         Int      @default(0)
  chatNo      String?
  iconDetail  String?
  iconTicket  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [textbookId], references: [textbookId], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@index([saleBeginAt])
  @@index([saleEndAt])
  @@index([createdAt])
}

model Course {
  textbookId    Int          @id
  textbookName  String
  icon          String?
  gradeId       Int?
  bookVersionId Int?
  sortValue     Int          @default(0)
  canLock       Int          @default(1)
  status        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  grade         Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  bookVersion   BookVersion? @relation(fields: [bookVersionId], references: [id], onDelete: SetNull)
  specialCourse SpecialCourse?
  orders        Order[]
  units         Unit[]
  passes        Pass[]
  sessions      Session[]
  sourceMaterials SourceMaterial[]
  learningRecords LearningRecord[]

  @@index([gradeId])
  @@index([bookVersionId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id              Int          @id @default(autoincrement())
  orderNo         String       @unique
  memberId        Int
  itemId          Int?
  itemName        String
  orderAmount     Int          @default(0)
  payType         Int          @default(1)
  orderStatus     Int          @default(1)
  payTime         DateTime?
  outNo           String?
  cancelReason    String?
  activityId      Int?
  textbookId      Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  member          Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  level           MemberLevel? @relation(fields: [itemId], references: [userLevel])
  activity        Activity?    @relation(fields: [activityId], references: [id])
  course          Course?      @relation(fields: [textbookId], references: [textbookId])

  @@index([memberId])
  @@index([itemId])
  @@index([payType])
  @@index([orderStatus])
  @@index([activityId])
  @@index([textbookId])
  @@index([createdAt])
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  roleMenus RoleMenu[]
}

model Menu {
  id         Int        @id @default(autoincrement())
  parentId   Int?
  parent     Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Menu[]     @relation("MenuTree")
  menuName   String
  path       String     @unique
  icon       String
  menuScope  Int        @default(1)
  url        String     @default("")
  status     Int        @default(1)
  sortValue  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  roleMenus  RoleMenu[]
  userMenus  UserMenu[]
}

/// 用户级菜单授权：存在记录时以本表为准（超管仍然看全部菜单）
model UserMenu {
  userId    Int
  menuId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([userId, menuId])
  @@index([menuId])
}

model RoleMenu {
  roleId     Int
  menuId     Int
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@index([menuId])
}

// 教学层级：教材 Course → 单元 Unit → Part → 关卡 Pass
model Unit {
  id         Int      @id @default(autoincrement())
  text       String
  icon       String?  @default("")
  sort       Int      @default(0)
  canLock    Int      @default(1)
  status     Int      @default(1)
  textbookId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [textbookId], references: [textbookId], onDelete: Cascade)
  parts      Part[]
  learningRecords LearningRecord[]

  @@index([textbookId])
  @@index([sort])
  @@index([createdAt])
}

model Part {
  id        Int      @id @default(autoincrement())
  title     String
  icon      String?  @default("")
  tips      String?  @default("")
  sort      Int      @default(0)
  canLock   Int      @default(1)
  unitsId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      Unit     @relation(fields: [unitsId], references: [id], onDelete: Cascade)
  passes    Pass[]
  learningRecords LearningRecord[]

  @@index([unitsId])
  @@index([sort])
  @@index([createdAt])
}

/// 关卡 / 小关卡共用一张表（旧后端设计）：
/// - 关卡（passes 页）：partsId 有值，带 subject / customerNumber / totalScore
/// - 小关卡（custom-passes 页）：textbookId 有值，带 tmpTitle
/// pass/list/:id 的 :id 语义由 query 中的 partsId / textbookId 决定。
model Pass {
  id             Int      @id @default(autoincrement())
  title          String
  tmpTitle       String?  @default("")
  icon           String?  @default("")
  sort           Int      @default(0)
  partsId        Int?
  textbookId     Int?
  subject        Int?
  customerNumber Int      @default(0)
  totalScore     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  part           Part?    @relation(fields: [partsId], references: [id], onDelete: Cascade)
  course         Course?  @relation(fields: [textbookId], references: [textbookId], onDelete: Cascade)
  subjects       Subject[]
  sessionBindings SessionCustomPass[]

  @@index([partsId])
  @@index([textbookId])
  @@index([sort])
  @@index([createdAt])
}

model Session {
  id         Int      @id
  textbookId Int
  title      String
  icon       String?  @default("")
  sort       Int      @default(0)
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [textbookId], references: [textbookId], onDelete: Cascade)
  customPasses SessionCustomPass[]
  learningRecords LearningRecord[]

  @@index([textbookId, sort])
}

model SessionCustomPass {
  id           Int        @id @default(autoincrement())
  sessionId    Int
  customPassId Int
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customPass   Pass       @relation(fields: [customPassId], references: [id], onDelete: Cascade)

  @@unique([sessionId, customPassId])
  @@index([sessionId, sort])
}

model Subject {
  id            Int      @id @default(autoincrement())
  customsPassId Int
  partId        Int?
  sessionId     Int?
  subject       Int?
  sourceIds     String   @default("")
  sort          Int      @default(0)
  showIndex     String?  @default("")
  icon          String?  @default("")
  audio         String?  @default("")
  sentenceAudio String?  @default("")
  sceneGraph    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customPass    Pass     @relation(fields: [customsPassId], references: [id], onDelete: Cascade)

  @@index([customsPassId, sort])
  @@index([createdAt])
}

model SourceMaterial {
  id            Int      @id @default(autoincrement())
  textbookId    Int
  text          String
  icon          String?  @default("")
  audio         String?  @default("")
  translation   String?  @default("")
  explainsArray String?  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [textbookId], references: [textbookId], onDelete: Cascade)

  @@index([textbookId])
  @@index([text])
  @@index([createdAt])
}

/// 邀请关系。Member 只有 inviteCount 聚合字段，无法查出「邀请了谁」，故单独建表。
model MemberInvite {
  id        Int      @id @default(autoincrement())
  inviterId Int
  inviteeId Int
  createdAt DateTime @default(now())
  inviter   Member   @relation("MemberInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   Member   @relation("MemberInviteReceiver", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeId])
  @@index([inviterId, createdAt])
  @@index([inviteeId])
}

model LearningRecord {
  id         Int      @id @default(autoincrement())
  memberId   Int
  textbookId Int?
  unitId     Int?
  partId     Int?
  sessionId  Int?
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  textbook   Course?  @relation(fields: [textbookId], references: [textbookId])
  unit       Unit?    @relation(fields: [unitId], references: [id])
  part       Part?    @relation(fields: [partId], references: [id])
  session    Session? @relation(fields: [sessionId], references: [id])

  @@index([memberId, createdAt])
}

/// 题型字典（pass/subject 的数据源）。
/// ⚠️ 仓库内没有真实题型取值——旧后端不在本仓，前端历来从接口拉取。
/// 这里只建表、不预置数据：需要补齐数据后 `pass/subject` 才会返回可选题型，
/// 在那之前关卡（Pass.subject 必填）无法新建。
model SubjectType {
  id        Int      @id @default(autoincrement())
  name      String
  sort      Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sort])
}
